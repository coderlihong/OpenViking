{
  "server": {
    "host": "0.0.0.0",
    "port": 1933,
    "root_api_key": "change-me"
  },
  "storage": {
    "workspace": "./data",
    "agfs": { "backend": "local" },
    "vectordb": { "backend": "local" }
  },
  "embedding": {
    "dense": {
      "provider": "volcengine",
      "model": "doubao-embedding-vision-251215",
      "api_base": "https://ark.cn-beijing.volces.com/api/v3",
      "api_key": "YOUR_API_KEY",
      "dimension": 1024
    }
  },
  "log": { "level": "INFO", "output": "stdout" }
}